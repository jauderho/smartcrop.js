{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": true
  },
  "include": [
    "index.d.ts",
    "smartcrop.js",
    "types/**/*.d.ts",
    "test/**/*.ts",
    "scripts/**/*.ts"
  ]
}
